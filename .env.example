# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
IS_PRODUCTION=False

# Database Configuration
# For Development: Set DATABASE_ENGINE=sqlite (uses db.sqlite3)
# For Production: Set DATABASE_ENGINE=mysql (uses MySQL database)
DATABASE_ENGINE=sqlite

# MySQL Settings (only needed if DATABASE_ENGINE=mysql)
DATABASE_NAME=calmspace
DATABASE_USER=root
DATABASE_PASSWORD=admin
DATABASE_HOST=localhost
DATABASE_PORT=3306

# Email Configuration (Gmail Example)
# To get your App Password, enable 2FA on Gmail then create app password at:
# https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Token Expiry (in seconds)
EMAIL_VERIFICATION_TOKEN_EXPIRY=86400
PASSWORD_RESET_TOKEN_EXPIRY=86400

# JWT Configuration (optional - adjust if needed)
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend URLs (for verification and reset links)
FRONTEND_BASE_URL=http://localhost:3000
